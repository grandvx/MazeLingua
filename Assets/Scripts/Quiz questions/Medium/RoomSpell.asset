  m_Name: RoomSpell
  m_EditorClassIdentifier: 
  questions:
  - questionText: 'You find a scroll next to a skull. What might this mean in a story? '
    questionLang: English
    answerOptions:
    - Someone is hungry
    - A spell or secret was discovered
    - There was a celebration
    - The place is a kitchen.
    correctAnswerIndex: 1
  - questionText: "Encuentras un pergamino junto a una calavera. \xBFQu\xE9 podr\xEDa
      significar esto en una historia?"
    questionLang: Spanish
    answerOptions:
    - Alguien tiene hambre
    - "Se descubri\xF3 un hechizo o un secreto"
    - Hubo una fiesta
    - Es una cocina
    correctAnswerIndex: 1
  - questionText: "Tu trouves un parchemin \xE0 c\xF4t\xE9 d\u2019un cr\xE2ne. Que
      cela pourrait-il signifier dans une histoire ?"
    questionLang: French
    answerOptions:
    - "Quelqu\u2019un a faim."
    - "Un sort ou un secret a \xE9t\xE9 d\xE9couvert. "
    - "C\u2019\xE9tait une f\xEAte."
    - "C\u2019est une cuisine."
    correctAnswerIndex: 1
  - questionText: "\u0391\u03BD \u03B2\u03C1\u03B5\u03B9\u03C2 \u03AD\u03BD\u03B1\u03BD
      \u03C0\u03AC\u03C0\u03C5\u03C1\u03BF \u03B4\u03AF\u03C0\u03BB\u03B1 \u03C3\u03B5
      \u03AD\u03BD\u03B1 \u03BA\u03C1\u03B1\u03BD\u03AF\u03BF, \u03C4\u03B9 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03B1\u03C5\u03C4\u03CC
      \u03C3\u03B5 \u03BC\u03B9\u03B1 \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B1;"
    questionLang: Greek
    answerOptions:
    - "\u039A\u03AC\u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03B5\u03B9\u03BD\u03AC\u03B5\u03B9."
    - "\u0391\u03BD\u03B1\u03BA\u03B1\u03BB\u03CD\u03C6\u03B8\u03B7\u03BA\u03B5 \u03AD\u03BD\u03B1
      \u03BE\u03CC\u03C1\u03BA\u03B9 \u03AE \u03AD\u03BD\u03B1 \u03BC\u03C5\u03C3\u03C4\u03B9\u03BA\u03CC"
    - "\u0388\u03B3\u03B9\u03BD\u03B5 \u03B3\u03B9\u03BF\u03C1\u03C4\u03AE."
    - "\u0395\u03AF\u03BD\u03B1\u03B9 \u03BA\u03BF\u03C5\u03B6\u03AF\u03BD\u03B1."
    correctAnswerIndex: 1
